<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollViewCrearAviso"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5FA"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <ImageButton
                android:id="@+id/buttonVolverCrearAviso"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/bg_boton_volver"
                android:src="@drawable/ic_volver"
                android:scaleType="center"
                android:padding="12dp"
                android:contentDescription="Volver atrás"
                android:clickable="true"
                android:focusable="true" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textViewTituloCrearAviso"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Crear aviso"
                    android:textColor="#2F2483"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Completá los datos del trabajo"
                    android:textColor="#77738B"
                    android:textSize="14sp" />

            </LinearLayout>

        </LinearLayout>


        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardUseCompatPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Información del trabajo"
                    android:textColor="#29263D"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />

                <!-- Fecha -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Fecha del trabajo"
                    android:textColor="#454357"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/editTextFechaAviso"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_campo_formulario"
                    android:clickable="true"
                    android:focusable="false"
                    android:drawableStart="@drawable/ic_calendario_aviso"
                    android:drawablePadding="12dp"
                    android:hint="Seleccionar fecha"
                    android:inputType="date"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="#29263D"
                    android:textColorHint="#898797"
                    android:textSize="14sp" />

                <!-- Hora -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="6dp"
                    android:text="Hora del trabajo"
                    android:textColor="#454357"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/editTextHoraAviso"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_campo_formulario"
                    android:clickable="true"
                    android:focusable="false"
                    android:hint="Seleccionar hora"
                    android:inputType="time"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="#29263D"
                    android:textColorHint="#898797"
                    android:textSize="14sp"
                    android:drawableStart="@drawable/ic_nav_pendientes"
                    android:drawablePadding="10dp"/>

                <!-- Dirección -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="6dp"
                    android:text="Dirección"
                    android:textColor="#454357"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/editTextDireccionAviso"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_campo_formulario"
                    android:hint="Calle, número y localidad"
                    android:inputType="textPostalAddress"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:singleLine="true"
                    android:textColor="#29263D"
                    android:textColorHint="#898797"
                    android:textSize="14sp" />

                <!-- Teléfono -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="6dp"
                    android:text="Teléfono de contacto"
                    android:textColor="#454357"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/editTextTelefonoAviso"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_campo_formulario"
                    android:hint="Número de teléfono"
                    android:inputType="phone"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:singleLine="true"
                    android:textColor="#29263D"
                    android:textColorHint="#898797"
                    android:textSize="14sp" />

                <!-- Mensaje -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="6dp"
                    android:text="Descripción del trabajo"
                    android:textColor="#454357"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/editTextMensajeAviso"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="100dp"
                    android:background="@drawable/bg_campo_formulario"
                    android:gravity="top|start"
                    android:hint="Describí qué trabajo hay que realizar"
                    android:inputType="textCapSentences|textMultiLine"
                    android:padding="14dp"
                    android:textColor="#29263D"
                    android:textColorHint="#898797"
                    android:textSize="14sp" />

                <!-- Observaciones -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="6dp"
                    android:text="Observaciones adicionales"
                    android:textColor="#454357"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/editTextObservacionAviso"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="90dp"
                    android:background="@drawable/bg_campo_formulario"
                    android:gravity="top|start"
                    android:hint="Detalles que deba tener en cuenta el operario"
                    android:inputType="textCapSentences|textMultiLine"
                    android:padding="14dp"
                    android:textColor="#29263D"
                    android:textColorHint="#898797"
                    android:textSize="14sp" />

                <!-- Urgencia -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="6dp"
                    android:text="Nivel de urgencia"
                    android:textColor="#454357"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spinnerUrgenciaAviso"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_campo_formulario"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:spinnerMode="dropdown" />

                <!-- Cliente -->

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="22dp"
                    android:layout_marginBottom="18dp"
                    android:background="#ECEAF3" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cliente"
                    android:textColor="#29263D"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="8dp"
                    android:text="Buscá un cliente existente o registrá uno nuevo."
                    android:textColor="#777587"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <AutoCompleteTextView
                        android:id="@+id/autoCompleteClienteAviso"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_campo_formulario"
                        android:completionThreshold="1"
                        android:hint="Buscar cliente"
                        android:inputType="textCapWords"
                        android:paddingStart="12dp"
                        android:paddingEnd="8dp"
                        android:singleLine="true"
                        android:textColor="#29263D"
                        android:textColorHint="#898797"
                        android:textSize="14sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonAnadirClienteAviso"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginStart="8dp"
                        android:minWidth="0dp"
                        android:text="Crear"
                        android:textAllCaps="false"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#2F2483"
                        app:backgroundTint="#F0EEFF"
                        app:cornerRadius="12dp"
                        app:strokeWidth="0dp" />

                </LinearLayout>

                <!-- Operario -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Operario asignado"
                    android:textColor="#29263D"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="8dp"
                    android:text="Elegí quién realizará el trabajo."
                    android:textColor="#777587"
                    android:textSize="13sp" />

                <AutoCompleteTextView
                    android:id="@+id/autoCompleteOperarioAviso"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_campo_formulario"
                    android:completionThreshold="1"
                    android:hint="Buscar operario"
                    android:inputType="textCapWords"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:singleLine="true"
                    android:textColor="#29263D"
                    android:textColorHint="#898797"
                    android:textSize="14sp" />

                <!-- Guardar -->

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonGuardarAviso"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="24dp"
                    android:text="Guardar aviso"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:backgroundTint="#2F2483"
                    app:cornerRadius="14dp"
                    app:iconGravity="textStart"
                    app:strokeWidth="0dp" />

                <ProgressBar
                    android:id="@+id/progressBarGuardarAviso"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:layout_marginTop="12dp"
                    android:indeterminateTint="#2F2483"
                    android:visibility="gone" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</ScrollView>
