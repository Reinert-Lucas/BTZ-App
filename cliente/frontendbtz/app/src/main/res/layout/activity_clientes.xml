<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5FA"
    android:paddingStart="18dp"
    android:paddingEnd="18dp"
    android:paddingBottom="12dp">

    <!-- Encabezado -->
    <LinearLayout
        android:id="@+id/contenedorTituloClientes"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="2dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/buttonVolverClientes"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="14dp"
            android:background="@drawable/bg_boton_volver"
            android:clickable="true"
            android:contentDescription="Volver atrás"
            android:focusable="true"
            android:padding="12dp"
            android:scaleType="center"
            android:src="@drawable/ic_volver" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textViewTituloClientes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Gestión de clientes"
                android:textColor="#2F2483"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textViewSubtituloClientes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Administrá los clientes registrados"
                android:textColor="#77738B"
                android:textSize="14sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Acción principal -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonNuevoCliente"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginStart="2dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="2dp"
        android:text="Nuevo cliente"
        app:icon="@drawable/ic_mas"
        app:iconGravity="textStart"
        app:iconTint="@android:color/white"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        app:backgroundTint="#2F2483"
        app:cornerRadius="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/contenedorTituloClientes" />

    <!-- Lista de clientes -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardListaClientes"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="4dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/buttonNuevoCliente">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewListaClientes"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="8dp"
            android:paddingTop="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp" />

    </androidx.cardview.widget.CardView>

    <!-- Indicador de carga -->
    <ProgressBar
        android:id="@+id/progressBarCargaClientes"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:indeterminateTint="#2F2483"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/cardListaClientes"
        app:layout_constraintEnd_toEndOf="@id/cardListaClientes"
        app:layout_constraintStart_toStartOf="@id/cardListaClientes"
        app:layout_constraintTop_toTopOf="@id/cardListaClientes" />

</androidx.constraintlayout.widget.ConstraintLayout>