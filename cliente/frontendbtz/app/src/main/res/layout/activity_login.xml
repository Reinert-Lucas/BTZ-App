<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="32dp"
    android:gravity="center_horizontal"
    android:background="#F2F2F2">

    <ImageView
        android:id="@+id/ivLogo"
        android:layout_width="374dp"
        android:layout_height="254dp"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="16dp"
        android:src="@drawable/logo_btz_2" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Iniciar Sesión"
        android:textColor="#000000"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Introduce tus Credenciales"
        android:textColor="#555555"
        android:textSize="14sp"
        android:layout_marginBottom="24dp"/>

    <!-- Input Usuario -->
    <EditText
        android:id="@+id/etUsuario"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/box_input_normal"
        android:hint="DNI"
        android:paddingHorizontal="16dp"
        android:textColorHint="#999999"
        android:inputType="number"
        android:layout_marginBottom="16dp"/>

    <!-- Input Contraseña -->
    <EditText
        android:id="@+id/etPassword"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/box_input_normal"
        android:hint="Contraseña"
        android:paddingHorizontal="16dp"
        android:textColorHint="#999999"
        android:inputType="textPassword"
        android:layout_marginBottom="24dp"/>

    <!-- Botón -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnIngresar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/box_boton_azul"
        android:text="Iniciar Sesión"
        android:textColor="#FFFFFF"
        android:textAllCaps="false"/>

    <!-- Mensaje de Error -->
    <TextView
        android:id="@+id/tvError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Usuario o contraseña incorrecta"
        android:textColor="#FF3B30"
        android:textSize="14sp"
        android:layout_marginTop="24dp"
        android:visibility="gone"/>

</LinearLayout>