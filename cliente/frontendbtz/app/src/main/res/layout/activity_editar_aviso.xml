<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:id="@+id/textViewTituloEditarAviso"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EDITAR AVISO"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <EditText
            android:id="@+id/editTextFechaEditarAviso"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:clickable="true"
            android:focusable="false"
            android:hint="Fecha"
            android:inputType="date"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textViewTituloEditarAviso" />

        <EditText
            android:id="@+id/editTextHoraEditarAviso"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:clickable="true"
            android:focusable="false"
            android:hint="Hora"
            android:inputType="time"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/editTextFechaEditarAviso" />

        <EditText
            android:id="@+id/editTextDireccionEditarAviso"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Dirección"
            android:inputType="textPostalAddress"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/editTextHoraEditarAviso" />

        <EditText
            android:id="@+id/editTextTelefonoEditarAviso"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Teléfono"
            android:inputType="phone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/editTextDireccionEditarAviso" />

        <EditText
            android:id="@+id/editTextMensajeEditarAviso"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Mensaje"
            android:inputType="textMultiLine"
            android:minLines="3"
            android:gravity="top"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/editTextTelefonoEditarAviso" />

        <EditText
            android:id="@+id/editTextObservacionEditarAviso"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Observación"
            android:inputType="textMultiLine"
            android:minLines="3"
            android:gravity="top"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/editTextMensajeEditarAviso" />

        <TextView
            android:id="@+id/textViewUrgenciaEditarAviso"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Prioridad"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/editTextObservacionEditarAviso" />

        <Spinner
            android:id="@+id/spinnerUrgenciaEditarAviso"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textViewUrgenciaEditarAviso" />

        <TextView
            android:id="@+id/textViewClienteEditarAviso"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Cliente"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/spinnerUrgenciaEditarAviso" />

        <AutoCompleteTextView
            android:id="@+id/autoCompleteClienteEditarAviso"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:completionThreshold="0"
            android:hint="Seleccionar cliente"
            android:inputType="text"
            app:layout_constraintEnd_toStartOf="@id/buttonAnadirClienteEditarAviso"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textViewClienteEditarAviso" />

        <Button
            android:id="@+id/buttonAnadirClienteEditarAviso"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Crear"
            app:layout_constraintBottom_toBottomOf="@id/autoCompleteClienteEditarAviso"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/autoCompleteClienteEditarAviso"
            app:layout_constraintTop_toTopOf="@id/autoCompleteClienteEditarAviso" />

        <TextView
            android:id="@+id/textViewOperarioEditarAviso"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Operario asignado"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/autoCompleteClienteEditarAviso" />

        <AutoCompleteTextView
            android:id="@+id/autoCompleteOperarioEditarAviso"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="Seleccionar operario"
            android:inputType="text"
            android:completionThreshold="0"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textViewOperarioEditarAviso" />

        <Button
            android:id="@+id/buttonGuardarCambiosAviso"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="GUARDAR CAMBIOS"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/autoCompleteOperarioEditarAviso" />

        <ProgressBar
            android:id="@+id/progressBarEditarAviso"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/buttonGuardarCambiosAviso"
            app:layout_constraintEnd_toEndOf="@id/buttonGuardarCambiosAviso"
            app:layout_constraintStart_toStartOf="@id/buttonGuardarCambiosAviso"
            app:layout_constraintTop_toTopOf="@id/buttonGuardarCambiosAviso" />

        <Button
            android:id="@+id/buttonEliminarAviso"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="ELIMINAR AVISO"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/buttonGuardarCambiosAviso" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>