<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5FA"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:id="@+id/scrollViewEditarAviso">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:paddingBottom="24dp">

        <!-- Encabezado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/buttonVolverEditarAviso"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/bg_boton_volver"
                android:src="@drawable/ic_volver"
                android:scaleType="center"
                android:padding="12dp"
                android:contentDescription="Volver atrás"
                android:clickable="true"
                android:focusable="true" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textViewTituloEditarAviso"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Editar aviso"
                    android:textColor="#2F2483"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Modificá los datos del trabajo"
                    android:textColor="#77738B"
                    android:textSize="14sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Tarjeta del formulario -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:contentPadding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Fecha -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Fecha"
                    android:textColor="#37334D"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/editTextFechaEditarAviso"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_campo_formulario"
                    android:clickable="true"
                    android:drawableStart="@drawable/ic_calendario_aviso"
                    android:drawablePadding="10dp"
                    android:focusable="false"
                    android:hint="Seleccionar fecha"
                    android:inputType="date"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="#29263D"
                    android:textColorHint="#89859C"
                    android:textSize="15sp" />

                <!-- Hora -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Hora"
                    android:textColor="#37334D"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/editTextHoraEditarAviso"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_campo_formulario"
                    android:clickable="true"
                    android:drawableStart="@drawable/ic_nav_pendientes"
                    android:drawablePadding="10dp"
                    android:focusable="false"
                    android:hint="Seleccionar hora"
                    android:inputType="time"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="#29263D"
                    android:textColorHint="#89859C"
                    android:textSize="15sp" />

                <!-- Dirección -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Dirección"
                    android:textColor="#37334D"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/editTextDireccionEditarAviso"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_campo_formulario"
                    android:hint="Ingresar dirección"
                    android:inputType="textPostalAddress"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="#29263D"
                    android:textColorHint="#89859C"
                    android:textSize="15sp" />

                <!-- Teléfono -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Teléfono"
                    android:textColor="#37334D"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/editTextTelefonoEditarAviso"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_campo_formulario"
                    android:hint="Ingresar teléfono"
                    android:inputType="phone"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="#29263D"
                    android:textColorHint="#89859C"
                    android:textSize="15sp" />

                <!-- Mensaje -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Mensaje"
                    android:textColor="#37334D"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/editTextMensajeEditarAviso"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_campo_formulario"
                    android:gravity="top|start"
                    android:hint="Descripción del trabajo"
                    android:inputType="textCapSentences|textMultiLine"
                    android:minHeight="90dp"
                    android:minLines="3"
                    android:padding="12dp"
                    android:textColor="#29263D"
                    android:textColorHint="#89859C"
                    android:textSize="15sp" />

                <!-- Observación -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Observaciones"
                    android:textColor="#37334D"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/editTextObservacionEditarAviso"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_campo_formulario"
                    android:gravity="top|start"
                    android:hint="Agregar observaciones (opcional)"
                    android:inputType="textCapSentences|textMultiLine"
                    android:minHeight="90dp"
                    android:minLines="3"
                    android:padding="12dp"
                    android:textColor="#29263D"
                    android:textColorHint="#89859C"
                    android:textSize="15sp" />

                <!-- Prioridad -->
                <TextView
                    android:id="@+id/textViewUrgenciaEditarAviso"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Prioridad"
                    android:textColor="#37334D"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spinnerUrgenciaEditarAviso"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_campo_formulario"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp" />

                <!-- Cliente -->
                <TextView
                    android:id="@+id/textViewClienteEditarAviso"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Cliente"
                    android:textColor="#37334D"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <AutoCompleteTextView
                        android:id="@+id/autoCompleteClienteEditarAviso"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_campo_formulario"
                        android:completionThreshold="1"
                        android:hint="Seleccionar cliente"
                        android:inputType="textCapWords"
                        android:paddingStart="12dp"
                        android:paddingEnd="8dp"
                        android:singleLine="true"
                        android:textColor="#29263D"
                        android:textColorHint="#89859C"
                        android:textSize="15sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonAnadirClienteEditarAviso"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginStart="8dp"
                        android:minWidth="0dp"
                        android:text="Crear"
                        android:textAllCaps="false"
                        android:textColor="#2F2483"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:backgroundTint="#F0EEFF"
                        app:cornerRadius="12dp"
                        app:strokeWidth="0dp" />

                </LinearLayout>

                <!-- Operario -->
                <TextView
                    android:id="@+id/textViewOperarioEditarAviso"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Operario asignado"
                    android:textColor="#37334D"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <AutoCompleteTextView
                    android:id="@+id/autoCompleteOperarioEditarAviso"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_campo_formulario"
                    android:completionThreshold="1"
                    android:hint="Seleccionar operario"
                    android:inputType="textCapWords"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:singleLine="true"
                    android:textColor="#29263D"
                    android:textColorHint="#89859C"
                    android:textSize="15sp" />

                <!-- Guardar cambios -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonGuardarCambiosAviso"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="24dp"
                    android:text="Guardar cambios"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:backgroundTint="#2F2483"
                    app:cornerRadius="14dp"
                    app:strokeWidth="0dp" />

                <ProgressBar
                    android:id="@+id/progressBarEditarAviso"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="12dp"
                    android:visibility="gone" />

                <!-- Separador -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="24dp"
                    android:background="#EAE7F2" />

                <!-- Eliminar aviso -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonEliminarAviso"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="16dp"
                    android:text="Eliminar aviso"
                    android:textAllCaps="false"
                    android:textColor="#C62828"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:backgroundTint="#FFF0F0"
                    app:cornerRadius="14dp"
                    app:strokeColor="#F1CACA"
                    app:strokeWidth="1dp" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</ScrollView>