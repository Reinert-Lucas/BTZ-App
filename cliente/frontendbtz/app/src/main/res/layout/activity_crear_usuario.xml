<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5FA"
    android:paddingStart="18dp"
    android:paddingEnd="18dp"
    android:paddingBottom="16dp">

    <ScrollView
        android:id="@+id/scrollViewCrearUsuario"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="24dp"
            android:paddingBottom="12dp">

            <!-- Encabezado -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/buttonVolverCrearUsuario"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_boton_volver"
                    android:contentDescription="Volver"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_volver"
                    app:tint="#2F2483" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/textViewTituloCrearUsuario"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Nuevo usuario"
                        android:textColor="#2F2483"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textViewSubtituloCrearUsuario"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Completá los datos del personal"
                        android:textColor="#77738B"
                        android:textSize="14sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- Formulario -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:contentPadding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Información del usuario"
                        android:textColor="#2F2483"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <!-- Nombre -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:layout_marginBottom="8dp"
                        android:text="Nombre completo"
                        android:textColor="#454158"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/editTextNombreUsuario"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_campo_formulario"
                        android:hint="Ingresá el nombre"
                        android:inputType="textPersonName|textCapWords"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:singleLine="true"
                        android:textColor="#29263A"
                        android:textColorHint="#9692A7"
                        android:textSize="15sp" />

                    <!-- DNI -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:layout_marginBottom="8dp"
                        android:text="DNI"
                        android:textColor="#454158"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/editTextDniUsuario"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_campo_formulario"
                        android:hint="Ingresá el DNI"
                        android:inputType="number"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:singleLine="true"
                        android:textColor="#29263A"
                        android:textColorHint="#9692A7"
                        android:textSize="15sp" />

                    <!-- Teléfono -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:layout_marginBottom="8dp"
                        android:text="Teléfono"
                        android:textColor="#454158"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/editTextTelefonoUsuario"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_campo_formulario"
                        android:hint="Ingresá el teléfono"
                        android:inputType="phone"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:singleLine="true"
                        android:textColor="#29263A"
                        android:textColorHint="#9692A7"
                        android:textSize="15sp" />

                    <!-- Contraseña -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:layout_marginBottom="8dp"
                        android:text="Contraseña"
                        android:textColor="#454158"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/editTextPasswordUsuario"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_campo_formulario"
                        android:hint="Mínimo 8 caracteres"
                        android:inputType="textPassword"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:singleLine="true"
                        android:textColor="#29263A"
                        android:textColorHint="#9692A7"
                        android:textSize="15sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="24dp"
                        android:layout_marginBottom="20dp"
                        android:background="#EAE8F1" />

                    <!-- Rol -->
                    <TextView
                        android:id="@+id/textViewRolUsuario"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Rol del usuario"
                        android:textColor="#29263A"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Seleccioná el tipo de acceso que tendrá."
                        android:textColor="#77738B"
                        android:textSize="13sp" />


                    <Spinner
                        android:id="@+id/spinnerRolUsuario"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_campo_formulario"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:spinnerMode="dropdown"
                        android:dropDownWidth="match_parent"
                        android:popupBackground="#FFFFFF" />


                    <!-- Guardar -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/buttonGuardarUsuario"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:text="Crear usuario"
                            android:textAllCaps="false"
                            android:textColor="@android:color/white"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            app:backgroundTint="#2F2483"
                            app:cornerRadius="12dp" />

                        <ProgressBar
                            android:id="@+id/progressBarGuardarUsuario"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:indeterminateTint="@android:color/white"
                            android:visibility="gone" />

                    </FrameLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>