<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5FA"
    android:paddingStart="18dp"
    android:paddingEnd="18dp"
    android:paddingBottom="16dp">

    <ScrollView
        android:id="@+id/scrollViewEditarCliente"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="24dp"
            android:paddingBottom="12dp">

            <!-- Encabezado -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/buttonVolverEditarCliente"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_boton_volver"
                    android:contentDescription="Volver"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_volver"
                    app:tint="#2F2483" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/textViewTituloEditarCliente"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Editar cliente"
                        android:textColor="#2F2483"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textViewSubtituloEditarCliente"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Modificá la información del cliente"
                        android:textColor="#77738B"
                        android:textSize="14sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- Formulario -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:contentPadding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Información del cliente"
                        android:textColor="#2F2483"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:layout_marginBottom="8dp"
                        android:text="Nombre completo"
                        android:textColor="#454158"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/editTextNombreCliente"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_campo_formulario"
                        android:hint="Ingresá el nombre"
                        android:inputType="textPersonName|textCapWords"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:singleLine="true"
                        android:textColor="#29263A"
                        android:textColorHint="#9692A7"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:layout_marginBottom="8dp"
                        android:text="Correo electrónico"
                        android:textColor="#454158"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/editTextEmailCliente"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_campo_formulario"
                        android:hint="ejemplo@correo.com"
                        android:inputType="textEmailAddress"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:singleLine="true"
                        android:textColor="#29263A"
                        android:textColorHint="#9692A7"
                        android:textSize="15sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="24dp"
                        android:layout_marginBottom="20dp"
                        android:background="#EAE8F1" />

                    <TextView
                        android:id="@+id/textViewAseguradoCliente"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="¿Es un cliente asegurado?"
                        android:textColor="#29263A"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Activá esta opción si el trabajo corresponde a un seguro."
                        android:textColor="#77738B"
                        android:textSize="13sp" />

                    <Switch
                        android:id="@+id/switchAseguradoCliente"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:minHeight="48dp"
                        android:paddingVertical="8dp"
                        android:text="Sí, es asegurado"
                        android:textColor="#454158"
                        android:textSize="14sp"
                        android:thumbTint="#2F2483"
                        android:trackTint="#D6D1EB"
                        android:showText="false" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="8dp"
                        android:text="Detalle del seguro"
                        android:textColor="#454158"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/editTextDetalleAseguradoCliente"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="52dp"
                        android:background="@drawable/bg_campo_formulario"
                        android:enabled="false"
                        android:gravity="top|start"
                        android:hint="Ingresá los detalles del asegurado"
                        android:inputType="textCapSentences|textMultiLine"
                        android:minLines="2"
                        android:paddingStart="14dp"
                        android:paddingTop="14dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="14dp"
                        android:textColor="#29263A"
                        android:textColorHint="#9692A7"
                        android:textSize="15sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonGuardarCambiosCliente"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="24dp"
                        android:text="Guardar cambios"
                        android:textAllCaps="false"
                        android:textColor="@android:color/white"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:backgroundTint="#2F2483"
                        app:cornerRadius="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonEliminarCliente"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="12dp"
                        android:text="Eliminar cliente"
                        android:textAllCaps="false"
                        android:textColor="@android:color/white"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:backgroundTint="#C62828"
                        app:cornerRadius="12dp" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </ScrollView>

    <ProgressBar
        android:id="@+id/progressBarEditarCliente"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:indeterminateTint="#2F2483"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>