<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollViewEditarUsuario"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5FA"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:id="@+id/layoutEditarUsuario"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="24dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <!-- Encabezado -->
        <LinearLayout
            android:id="@+id/layoutEncabezadoEditarUsuario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/buttonVolverEditarUsuario"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/bg_boton_volver"
                android:contentDescription="Volver atrás"
                android:clickable="true"
                android:focusable="true"
                android:padding="12dp"
                android:scaleType="center"
                android:src="@drawable/ic_volver" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textViewTituloEditarUsuario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Editar usuario"
                    android:textColor="#2F2483"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textViewSubtituloEditarUsuario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Modificá los datos y permisos del usuario."
                    android:textColor="#77738B"
                    android:textSize="14sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Tarjeta del formulario -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardFormularioEditarUsuario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:contentPadding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Datos personales -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Datos personales"
                    android:textColor="#2F2483"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <!-- Nombre completo -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:labelFor="@id/editTextNombreUsuario"
                    android:text="Nombre completo"
                    android:textColor="#37334D"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/editTextNombreUsuario"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_campo_formulario"
                    android:hint="Ingresá el nombre completo"
                    android:inputType="textCapWords|textPersonName"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:singleLine="true"
                    android:textColor="#29263D"
                    android:textColorHint="#89859C"
                    android:textSize="15sp" />

                <!-- DNI -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:labelFor="@id/editTextDniUsuario"
                    android:text="DNI"
                    android:textColor="#37334D"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/editTextDniUsuario"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_campo_formulario"
                    android:hint="Ingresá el DNI"
                    android:inputType="number"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:singleLine="true"
                    android:textColor="#29263D"
                    android:textColorHint="#89859C"
                    android:textSize="15sp" />

                <!-- Teléfono -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:labelFor="@id/editTextTelefonoUsuario"
                    android:text="Teléfono"
                    android:textColor="#37334D"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/editTextTelefonoUsuario"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_campo_formulario"
                    android:hint="Ingresá el teléfono"
                    android:inputType="phone"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:singleLine="true"
                    android:textColor="#29263D"
                    android:textColorHint="#89859C"
                    android:textSize="15sp" />

                <!-- Separador -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="20dp"
                    android:background="#EAE7F2" />

                <!-- Acceso y permisos -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Acceso y permisos"
                    android:textColor="#2F2483"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <!-- Rol -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Rol del usuario"
                    android:textColor="#37334D"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spinnerRolUsuario"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_campo_formulario"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:spinnerMode="dropdown"
                    android:dropDownWidth="match_parent"
                    android:popupBackground="#FFFFFF" />


                <!-- Nueva contraseña -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:labelFor="@id/editTextPasswordUsuario"
                    android:text="Nueva contraseña"
                    android:textColor="#37334D"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/editTextPasswordUsuario"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_campo_formulario"
                    android:hint="Dejar vacía para mantener la actual"
                    android:inputType="textPassword"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:singleLine="true"
                    android:textColor="#29263D"
                    android:textColorHint="#89859C"
                    android:textSize="14sp" />

                <!-- Guardar cambios -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonGuardarCambiosUsuario"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="24dp"
                    android:text="Guardar cambios"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:backgroundTint="#2F2483"
                    app:cornerRadius="14dp"
                    app:iconGravity="textStart"
                    app:iconPadding="10dp"
                    app:strokeWidth="0dp" />

                <!-- Indicador de carga -->
                <ProgressBar
                    android:id="@+id/progressBarEditarUsuario"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="12dp"
                    android:visibility="gone" />

                <!-- Separador -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="24dp"
                    android:background="#EAE7F2" />

                <!-- Eliminar usuario -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonEliminarUsuario"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="16dp"
                    android:text="Eliminar usuario"
                    android:textAllCaps="false"
                    android:textColor="#C62828"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:backgroundTint="#FFF0F0"
                    app:cornerRadius="14dp"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:iconTint="#C62828"
                    app:strokeColor="#F1CACA"
                    app:strokeWidth="1dp" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>